{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pgh.local/contracts/pgd-1.0/systemic-view-sync.schema.json",
  "title":"PGD Dynamic Systemic View",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","view_id","view_kind","project_ref","base_tree_refs","base_revision","base_hash","root_entrypoints","local_index_ref","private_index","last_wcb_epoch","generated_at"],
  "properties":{
    "schema_version":{"const":"pgd-systemic-view-sync/1"},
    "view_id":{"type":"string","minLength":1,"maxLength":240},
    "view_kind":{"enum":["PROJECT_MAP","INFRASTRUCTURE_MAP","RESOURCE_MAP","AUTHORIZATION_MAP","TASK_MAP"]},
    "project_ref":{"type":["string","null"],"maxLength":240},
    "base_tree_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1,"maxLength":500},"uniqueItems":true},
    "base_revision":{"type":"integer","minimum":0},
    "base_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "root_entrypoints":{"type":"array","minItems":1,"items":{"type":"string","minLength":1,"maxLength":300},"uniqueItems":true},
    "local_index_ref":{"type":"string","minLength":1,"maxLength":500},
    "private_index":{
      "type":"object","additionalProperties":false,
      "required":["allowed","authority","derived_from_base_revision","invalidate_on_base_change"],
      "properties":{
        "allowed":{"const":true},
        "authority":{"const":false},
        "derived_from_base_revision":{"type":"integer","minimum":0},
        "invalidate_on_base_change":{"const":true}
      }
    },
    "last_wcb_epoch":{"type":"integer","minimum":0},
    "generated_at":{"type":"string","minLength":1}
  }
}
