{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgh.local/contracts/pgd-1.0/work-unit-execution-outcome.schema.json",
  "title": "PGD WorkUnit terminal execution outcome evidence",
  "description": "Terminal observed execution evidence consumed by PGD completion. RHGD may transport/reference it but cannot complete work or expand authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome_id",
    "project_ref",
    "work_unit_id",
    "execution_ref",
    "assignment",
    "lease_ref",
    "status",
    "retryable",
    "outcome_classification",
    "completion_owner",
    "authority_effect",
    "completed_at",
    "idempotency_key",
    "provenance_refs",
    "evidence_refs",
    "runtime_observation",
    "result",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "pgd-work-unit-execution-outcome/1"},
    "outcome_id": {"type": "string", "pattern": "^outcome://[^\\s]+$"},
    "project_ref": {"type": "string", "minLength": 1},
    "work_unit_id": {"type": "string", "minLength": 1},
    "execution_ref": {"type": "string", "minLength": 1},
    "assignment": {"$ref": "#/$defs/assignmentFence"},
    "lease_ref": {"type": ["string", "null"], "minLength": 1},
    "status": {"enum": ["SUCCEEDED", "FAILED"]},
    "retryable": {"type": "boolean"},
    "outcome_classification": {"const": "observed"},
    "completion_owner": {"const": "PGD"},
    "authority_effect": {"const": "NONE"},
    "completed_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "runtime_observation": {"$ref": "#/$defs/runtimeObservation"},
    "result": {
      "oneOf": [
        {"$ref": "#/$defs/result"},
        {"type": "null"}
      ]
    },
    "error": {
      "oneOf": [
        {"$ref": "#/$defs/error"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUCCEEDED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "retryable": {"const": false},
          "result": {"$ref": "#/$defs/result"},
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "FAILED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "result": {"type": "null"},
          "error": {"$ref": "#/$defs/error"},
          "evidence_refs": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "assignmentFence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "assignment_epoch"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "assignment_epoch": {"type": "integer", "minimum": 1}
      }
    },
    "runtimeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_ref", "model_version", "host_ref", "transport_ref"],
      "properties": {
        "model_ref": {"type": ["string", "null"], "minLength": 1},
        "model_version": {"type": ["string", "null"], "minLength": 1},
        "host_ref": {"type": ["string", "null"], "minLength": 1},
        "transport_ref": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_ref", "output_schema_ref", "content_hash", "payload"],
      "properties": {
        "result_ref": {"type": "string", "pattern": "^result://[^\\s]+$"},
        "output_schema_ref": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "payload": {}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "evidence_refs"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
