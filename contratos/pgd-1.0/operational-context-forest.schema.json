{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pgh.local/contracts/pgd-1.0/operational-context-forest.schema.json",
  "title":"PGD Operational Context Forest",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","forest_id","revision","content_hash","navigator_ref","graph_refs","root_instruction","last_wcb_epoch","generated_at"],
  "properties":{
    "schema_version":{"const":"pgd-operational-context-forest/1"},
    "forest_id":{"type":"string","minLength":1,"maxLength":240},
    "revision":{"type":"integer","minimum":0},
    "content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "navigator_ref":{"type":"string","minLength":1,"maxLength":500},
    "graph_refs":{
      "type":"object","additionalProperties":false,
      "required":["SYSTEM_NAVIGATOR","PROJECT","TASK","RESOURCE","AUTHORIZATION","CAPABILITY_ROUTING","KNOWLEDGE","ARTIFACT","STATE_HEALTH","COMMUNICATION","PROVENANCE_FRESHNESS","PEER_FEDERATION"],
      "properties":{
        "SYSTEM_NAVIGATOR":{"$ref":"#/$defs/graphRef"},"PROJECT":{"$ref":"#/$defs/graphRef"},"TASK":{"$ref":"#/$defs/graphRef"},
        "RESOURCE":{"$ref":"#/$defs/graphRef"},"AUTHORIZATION":{"$ref":"#/$defs/graphRef"},"CAPABILITY_ROUTING":{"$ref":"#/$defs/graphRef"},
        "KNOWLEDGE":{"$ref":"#/$defs/graphRef"},"ARTIFACT":{"$ref":"#/$defs/graphRef"},"STATE_HEALTH":{"$ref":"#/$defs/graphRef"},
        "COMMUNICATION":{"$ref":"#/$defs/graphRef"},"PROVENANCE_FRESHNESS":{"$ref":"#/$defs/graphRef"},"PEER_FEDERATION":{"$ref":"#/$defs/graphRef"}
      }
    },
    "root_instruction":{"type":"string","minLength":1,"maxLength":1200},
    "last_wcb_epoch":{"type":"integer","minimum":0},
    "generated_at":{"type":"string","minLength":1}
  },
  "$defs":{"graphRef":{"type":"object","additionalProperties":false,"required":["graph_ref","revision","content_hash","authority_ref","source_ref"],"properties":{
    "graph_ref":{"type":"string","minLength":1,"maxLength":500},"revision":{"type":"integer","minimum":0},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authority_ref":{"type":"string","minLength":1,"maxLength":500},"source_ref":{"type":"string","minLength":1,"maxLength":500}
  }}}
}
